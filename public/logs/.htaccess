# Deny direct browser access to all files in this directory.
# This prevents the CSV log from being publicly readable.

# Apache 2.4+
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

# Apache 2.2 legacy fallback
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
